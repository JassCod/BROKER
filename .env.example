# --- API server (server/index.js) ---
PORT=8080
# Required in production. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# SQLite file location. Mount persistent storage here in production.
DB_PATH=./data/roadtrain.db
# Load the sample companies on first start (set to false for a clean production database).
SEED_DEMO=true
# Only needed when the website is hosted on a different domain from the API.
CORS_ORIGIN=

# --- Website build ---
# Leave empty for demo mode. Use /api when the API serves the site, or a full URL for a separate API host.
VITE_API_URL=
